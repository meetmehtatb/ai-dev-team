# Copy to .env (never commit .env).

# GitHub token used by gh and git inside the container.
# Fine-grained token for the target repo: Contents, Issues, Pull requests = Read and write.
GH_TOKEN=

# Optional. Leave empty to log in with your Claude account (Pro/Max) on first run instead.
ANTHROPIC_API_KEY=

# Your git identity: commits and PRs are made as you.
# Use the email on your GitHub account (or <id>+<user>@users.noreply.github.com).
GIT_USER_NAME=
GIT_USER_EMAIL=
